# Copy to .env in this folder, then also into orchestrator-work/
#   cp .env.example .env    # fill in the values
#   cp .env orchestrator-work/.env
#
# Every agent loads orchestrator-work/.env. The real .env is gitignored.

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# --- Supabase ---
# Use the service_role key here, not the anon key. Backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# --- Orchestrator ---
# Local dev only. Allows unauthenticated /chat and /ask calls so the test
# script and /docs work without a token. Must be true anywhere else.
REQUIRE_AUTH=false

# Origins allowed to call the orchestrator from a browser.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest course material upload accepted, in megabytes.
# MAX_UPLOAD_MB=10
